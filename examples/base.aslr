  @extern("u64_from_u32")
  public func from(a: u32): u64

  @extern("u64_from_f64")
  public func from(a: f64): Status[u64]

  # user functions
  public func div_ceil(a: u64, b: u64): Status[u64]
    match u64.add(a, b):
      case Ok { value: val1 }:
        match u64.subtract(val1, 1):
          case Ok { value: val2 }:
            u64.quotient(val2, b)
          case Err { error: err2 }:
            Status[u64].Err { error: err2 }
      case Err { error: err1 }:
        Status[u64].Err { error: err1 }

  public func max(a: u64, b: u64): u64
    match u64.compare(a, b):
      case 1:
        a
      case _:
        b


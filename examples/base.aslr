public module u32:
  literal: "uint32"

  # binary
  @extern("u32_and_u32")
  public func and(a: u32, b: u32): u32

  @extern("u32_or_u32")
  public func or(a: u32, b: u32): u32

  @extern("u32_xor_u32")
  public func xor(a: u32, b: u32): u32

  @extern("u32_shr_u32")
  public func shr(a: u32, b: u32): u32

  @extern("u32_shl_u32")
  public func shl(a: u32, b: u32): u32

  @extern("u32_not_u32")
  public func not(a: u32): u32

  # arithematic
  @extern("u32_add_u32")
  public func add(a: u32, b: u32): Status[u32]

  @extern("u32_subtract_u32")
  public func subtract(a: u32, b: u32): Status[u32]

  @extern("u32_multiply_u32")
  public func multiply(a: u32, b: u32): Status[u32]

  @extern("u32_quotient_u32")
  public func quotient(a: u32, b: u32): u32

  @extern("u32_remainder_u32")
  public func remainder(a: u32, b: u32): u32

  # branching
  @extern("u32_compare_u32")
  public func compare(a: u32, b: u32): i8

  # casting
  @extern("u32_from_u8")
  public func from(a: u8): u32

  @extern("u32_from_f32")
  public func from(a: f32): Status[u32]

  @extern("u32_from_f64")
  public func from(a: f64): Status[u32]

  @extern("u32_from_i64")
  public func from(a: i64): Status[u32]

  # user functions
  public func div_ceil(a: u32, b: u32): Status[u32]
    match u32.add(a, b):
      case Ok { value: val1 }:
        match u32.subtract(val1, 1):
          case Ok { value: val2 }:
            Status.Ok { value: u32.quotient(val2, b) }
          case Err { error: err2 }:
            Status[u32].Err { error: err2 }
      case Err { error: err1 }:
        Status[u32].Err { error: err1 }

  public func max(a: u32, b: u32): u32
    match u32.compare(a, b):
      case 1:
        a
      case _:
        b

public module u64:

  # casting
  @extern("f64_from_u32")
  public func from(a: u32): f64

  @extern("f64_from_u64")
  public func from(a: u64): f64

  # user functions
  public func clamp(x: f64, lo: f64, hi: f64): f64
    match f64.compare(x, lo):
      case -1:
        lo
      case _:
        match f64.compare(x, hi):
          case 1:
            hi
          case _:
            x

  public func softmax(x: f64): f64
    match f64.compare(x, f64 0.0):
      case -1:
        f64 0.0
      case _:
        x

  public func negate(x: f64): Status[f64]
    f64.subtract(f64 0.0, x)


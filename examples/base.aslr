  @extern("i64_remainder_i64")
  public func remainder(a: i64, b: i64): i64

  # branching
  @extern("i64_compare_i64")
  public func compare(a: i64, b: i64): i8

  # absolute value
  @extern("i64_abs_i64")
  public func abs(a: i64): i64

  # casting
  @extern("i64_from_u32")
  public func from(a: u32): i64

  # user functions
  public func clamp(x: i64, lo: i64, hi: i64): i64
    match i64.compare(x, lo):
      case -1:
        lo
      case _:
        match i64.compare(x, hi):
          case 1:
            hi
          case _:
            x

  public func softmax(x: i64): i64
    match i64.compare(x, i64 0):
      case -1:
        i64 0
      case _:
        x

  public func negate(x: i64): Status[i64]
    i64.subtract(i64 0, x)

# TODO(float-special-values): f32 / f64 modules do not yet expose
# Inf / -Inf / NaN as values, nor classification predicates
# (`is_finite`, `is_nan`, `is_inf`). The literal-validator in the
# analyzer mirrors this: it rejects parse results that classify as
# Inf or NaN, since there is no surface form to write one. When the
# language grows special-value literals (`f32.inf`, `f32.nan`, etc.)
# and classifiers, both this module and the analyzer's parseFloat
# helper should pick them up.
public module f32:
  literal: "float32"

  # binary
  @extern("f32_and_f32")
  public func and(a: f32, b: f32): f32

  @extern("f32_or_f32")
  public func or(a: f32, b: f32): f32

  @extern("f32_xor_f32")
  public func xor(a: f32, b: f32): f32

  @extern("f32_not_f32")
  public func not(a: f32): f32

  # arithematic
  @extern("f32_add_f32")
  public func add(a: f32, b: f32): Status[f32]

  @extern("f32_subtract_f32")
  public func subtract(a: f32, b: f32): Status[f32]

  @extern("f32_multiply_f32")
  public func multiply(a: f32, b: f32): Status[f32]

  @extern("f32_quotient_f32")
  public func quotient(a: f32, b: f32): Status[f32]

  @extern("f32_remainder_f32")
  public func remainder(a: f32, b: f32): f32

  # branching
  @extern("f32_compare_f32")
  public func compare(a: f32, b: f32): i8

  # absolute value
  @extern("f32_abs_f32")
  public func abs(a: f32): f32

  # casting
  @extern("f32_from_u32")
  public func from(a: u32): f32

# See the TODO above f32 — the same special-value gap applies to f64.
public module f64:
  literal: "float64"

  # binary
  @extern("f64_and_f64")
